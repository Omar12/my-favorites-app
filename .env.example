# Postgres connection string (Neon in production, local Postgres in development)
DATABASE_URL=postgres://wir:wir@localhost:5432/wir
# Public origin of the site, used for absolute URLs in link previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Profile that "/" redirects to
DEFAULT_USERNAME=omar
# Email address the owner signs in with (used by `npm run db:owner`)
OWNER_EMAIL=you@example.com
# Random secret for signing sessions: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Resend API key for sign-in emails. Without it, development prints the link to the terminal.
RESEND_API_KEY=
# Optional sender on a domain verified in Resend, e.g. "What I Recommend <hello@yourdomain.com>"
# EMAIL_FROM=
